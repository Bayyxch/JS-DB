# Required
DISCORD_TOKEN=

# Optional: owner Discord user ID. Enables !admin commands.
OWNER_ID=

# Optional: set this to use a guild for development-only diagnostics.
DISCORD_GUILD_ID=

# Database path. Relative paths are resolved from the project root.
DATABASE_PATH=./data/sawit.sqlite

# Bot prefix
PREFIX=!

# Custom emoji strings. Paste the full Discord custom emoji syntax, for example:
# <:sawit:123456789012345678>
# Leave blank to use text fallbacks such as [PALM].
EMOJI_PALM=
EMOJI_COIN=
EMOJI_TBS=
EMOJI_SEED=
EMOJI_LAND=
EMOJI_TOOL=
EMOJI_SUCCESS=
EMOJI_WARNING=
EMOJI_FACTORY=

# Economy tuning. Keep these in config so balancing does not require code edits.
STARTING_BALANCE=2500
STARTING_SEEDS=8
STARTING_PLOTS=4

BASIC_SEED_PRICE=300
# Plant growth defaults to 30 seconds and is capped at 60 seconds.
BASIC_GROW_SECONDS=30
BASIC_MIN_YIELD=6
BASIC_MAX_YIELD=8
TBS_SELL_PRICE=70

FIRST_LAND_COST=12000
LAND_COST_MULTIPLIER=1.32
MAX_PLOTS=100

WORK_MIN_REWARD=100
WORK_MAX_REWARD=180
WORK_COOLDOWN_MINUTES=120
DAILY_REWARD=250
DAILY_COOLDOWN_HOURS=24

# Operational settings
LOG_LEVEL=info
